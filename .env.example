# Your Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for the replies.
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated people the assistant may reply to.
# Use full international numbers without "+" (e.g. 2348012345678),
# or exact chat IDs that appear in the log.
# "*" allows everyone - not recommended.
ALLOWLIST=

# Optional: your own WhatsApp number, digits only with country code (e.g. 2348012345678).
# When set and the bot is not linked yet, it shows an 8-digit pairing code instead of a QR
# code - for linking on the same phone: Linked devices -> Link with phone number instead.
# Leave empty to scan a QR code instead.
PAIRING_NUMBER=

# false = watch only: log incoming messages, send nothing. Start here.
# true  = automatically reply to people in ALLOWLIST.
AUTO_REPLY=false

# Seconds to wait after the last message of a burst before replying (default 10).
# Someone who sends several messages quickly gets ONE reply to all of them.
REPLY_DELAY_SECONDS=10

# How many messages per chat the assistant remembers (default 12).
# Memory is saved to history.json and survives restarts.
HISTORY_LIMIT=12

# Optional: hours when the assistant stays silent, 24h format, e.g. 23-7 means
# 23:00 to 07:00 (overnight ranges work). Empty or missing = no quiet hours.
# Messages are saved to memory and the next one after the window ends gets a
# normal reply; urgent alerts (notification + flashlight) still fire then.
QUIET_HOURS=

# Maximum assistant replies ONE stranger can get per day - a "stranger" is any
# number not listed explicitly in ALLOWLIST (only possible when ALLOWLIST=*).
# Protects your free Gemini quota from a junk number. People you list in
# ALLOWLIST are never capped. 0 = no cap.
MAX_REPLIES_PER_CHAT_PER_DAY=10
