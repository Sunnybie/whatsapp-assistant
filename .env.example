# Your Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for the replies.
GEMINI_MODEL=gemini-3.5-flash

# Comma-separated people the assistant may reply to.
# Use full international numbers without "+" (e.g. 2348012345678),
# or exact chat IDs that appear in the log.
# "*" allows everyone - not recommended.
ALLOWLIST=

# false = watch only: log incoming messages, send nothing. Start here.
# true  = automatically reply to people in ALLOWLIST.
AUTO_REPLY=false
